# Publisher-owned values. Development works without these; store builds require them.
CAMPUS_IOS_BUNDLE_ID=
CAMPUS_ANDROID_PACKAGE=
EXPO_OWNER=
EAS_PROJECT_ID=
# Public HTTPS privacy/support pages belonging to the app publisher.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
# Optional first-party content endpoint. The bundled guide works offline without it.
EXPO_PUBLIC_CONTENT_URL=
# Optional Naver native map: excluded from autolinking by default.
# Run npm run naver:enable and test both native platforms before enabling.
CAMPUS_ENABLE_NAVER=0
# Public mobile SDK identifier, restricted to your bundle/package IDs in Naver Cloud.
EXPO_PUBLIC_NAVER_KEY_ID=
# NEVER put ADMIN_TOKEN, LLM API keys, signing keys or database passwords here.
