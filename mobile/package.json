{
  "name": "myongji-campus-explorer-mobile",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "node setup.cjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "export:native": "expo export --platform all --output-dir dist",
    "check:release": "node scripts/release-check.cjs",
    "eas-build-pre-install": "node scripts/release-check.cjs --eas-hook",
    "naver:enable": "node scripts/naver-toggle.cjs enable",
    "naver:disable": "node scripts/naver-toggle.cjs disable"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "exclude": [
        "campus-naver"
      ]
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  }
}
