{
  "cli": { "version": "24.8.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development" },
    "preview": { "distribution": "internal", "environment": "preview", "android": { "buildType": "apk" } },
    "simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": { "distribution": "store", "environment": "production", "autoIncrement": true, "android": { "buildType": "app-bundle" }, "ios": { "simulator": false } }
  },
  "submit": {
    "production": { "android": { "track": "internal", "releaseStatus": "draft" }, "ios": {} }
  }
}
