{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "build/core",
    "skipLibCheck": true
  },
  "include": [
    "src/types.ts",
    "src/building-photos.ts",
    "src/core.ts",
    "src/data.ts",
    "src/knowledge.ts",
    "src/campus.ts",
    "src/visual-references.ts",
    "src/campuses.ts",
    "src/seoul-vegetation.ts",
    "src/seoul-details.ts",
    "src/campus-url.ts",
    "src/geographic.ts",
    "src/naver.ts",
    "src/location.ts",
    "src/model-location.ts",
    "src/community.ts",
    "src/community-updates.ts",
    "src/community-sync.ts",
    "src/community-web.ts"
  ]
}
