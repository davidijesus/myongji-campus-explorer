# Server only. Do not copy these values to mobile/.env or EXPO_PUBLIC_*.
# Generate your own token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
CONTENT_FILE=./data/published-campus.json
PORT=8080
HOST=127.0.0.1
# CLI target. Use HTTPS for remote hosts.
CONTENT_SERVER_URL=http://127.0.0.1:8080
